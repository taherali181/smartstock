  },
  "components": {
    "schemas": {
      "AdjustmentResponse": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Transaction Id"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed"
          },
          "position": {
            "$ref": "#/components/schemas/InventoryPositionResponse"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transaction_id",
          "replayed",
          "position"
        ],
        "title": "AdjustmentResponse"
      },
      "ApprovalPolicyResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "action_type": {
            "type": "string",
            "title": "Action Type"
          },
          "minimum_approvals": {
            "type": "integer",
            "title": "Minimum Approvals"
          },
          "approver_permission": {
            "type": "string",
            "title": "Approver Permission"
          },
          "amount_threshold": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Threshold"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "action_type",
          "minimum_approvals",
          "approver_permission",
          "amount_threshold",
          "currency",
          "active"
        ],
        "title": "ApprovalPolicyResponse"
      },
      "FeatureFlagResponse": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "configuration": {
            "additionalProperties": true,
            "type": "object",
            "title": "Configuration"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "enabled",
          "configuration"
        ],
        "title": "FeatureFlagResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InventoryAdjustmentRequest": {
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid",
            "title": "Product Id"
          },
          "warehouse_id": {
            "type": "string",
            "format": "uuid",
            "title": "Warehouse Id"
          },
          "location_id": {
            "type": "string",
            "format": "uuid",
            "title": "Location Id"
          },
          "quantity_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Quantity Delta"
          },
          "uom": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Uom"
          },
          "condition": {
            "$ref": "#/components/schemas/StockCondition",
            "default": "sellable"
          },
          "lot_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lot Id"
          },
          "serial_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial Id"
          },
          "ownership": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Ownership",
            "default": "owned"
          },
          "reason_code": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Reason Code"
          },
          "business_reference": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Business Reference"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "allow_negative": {
            "type": "boolean",
            "title": "Allow Negative",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "warehouse_id",
          "location_id",
          "quantity_delta",
          "uom",
          "reason_code",
          "business_reference",
          "expected_version"
        ],
        "title": "InventoryAdjustmentRequest"
      },
      "InventoryPositionResponse": {
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid",
            "title": "Product Id"
          },
          "warehouse_id": {
            "type": "string",
            "format": "uuid",
            "title": "Warehouse Id"
          },
          "location_id": {
            "type": "string",
            "format": "uuid",
            "title": "Location Id"
          },
          "uom": {
            "type": "string",
            "title": "Uom"
          },
          "condition": {
            "$ref": "#/components/schemas/StockCondition"
          },
          "lot_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lot Id"
          },
          "serial_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial Id"
          },
          "ownership": {
            "type": "string",
            "title": "Ownership"
          },
          "on_hand": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "On Hand"
          },
          "reserved": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Reserved"
          },
          "available": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Available"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "warehouse_id",
          "location_id",
          "uom",
          "condition",
          "lot_id",
          "serial_id",
          "ownership",
          "on_hand",
          "reserved",
          "available",
          "version",
          "updated_at"
        ],
        "title": "InventoryPositionResponse"
      },
      "OrganizationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "valuation_method": {
            "type": "string",
            "title": "Valuation Method"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "currency",
          "valuation_method"
        ],
        "title": "OrganizationResponse"
      },
      "PositionListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/InventoryPositionResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "PositionListResponse"
      },
      "StockCondition": {
        "type": "string",
        "enum": [
          "sellable",
          "quarantined",
          "damaged",
          "expired"
        ],
        "title": "StockCondition"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
