            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalPolicyResponse"
                  },
                  "title": "Response Approval Policies V1 Approval Policies Get"
                }
              }
            }
          },
          "422": {
